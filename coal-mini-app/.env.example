# Coal Mini App — env template.
# Copy to .env.local and fill in the blanks.

# ─── Worldcoin Developer Portal (https://developer.worldcoin.org) ─────
# Create an app in the portal, mark it as a Mini App. Staging apps use
# the app_staging_ prefix; production apps use app_.
NEXT_PUBLIC_WORLD_APP_ID=app_staging_REPLACE_ME

# Incognito Action used for World ID verification in the Me tab.
# Create in the portal > Incognito Actions. Must match the action name used
# in components/WorldIdVerify.tsx.
NEXT_PUBLIC_WORLD_ACTION=verify_coal_user

# Server-side API key for verifying World ID proofs against the portal.
# Used by /api/worldid/verify when enabled. Leave unset for now; the
# wallet-auth flow below works without it.
WORLD_API_KEY=

# ─── Coal backend ─────────────────────────────────────────────────────
# Where this Mini App reads product data and creates payment sessions.
# Local dev: http://localhost:3001 (the backend/ dev server)
# Production: https://api.usecoal.xyz
NEXT_PUBLIC_COAL_API_URL=http://localhost:3001

# ─── SIWE / session ───────────────────────────────────────────────────
# Used by the SIWE login route to verify wallet auth signatures. Any
# long random string; regenerate per environment.
SIWE_SESSION_SECRET=change-me-32-bytes-of-random

# Optional: pin a single demo merchant's payment-link slugs so the Shop
# tab shows a curated set of products. Leave blank to pull the whole
# public catalog from /api/agent/discover/products.
# Comma-separated list of payment-link slugs:
NEXT_PUBLIC_DEMO_LINK_SLUGS=
