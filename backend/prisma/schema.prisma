generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  engineType      = "client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  emailVerified        Boolean?
  image                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  payoutAddress        String?
  webhookSecret        String?
  webhookUrl           String?
  privyDid             String?               @unique
  onboardingComplete   Boolean               @default(false)
  onboardingStep       Int                   @default(0)
  accounts             Account[]
  apiKeys              ApiKey[]
  billingMandates      BillingMandate[]
  chainAnchors         ChainAnchor[]
  checkouts            CheckoutSession[]
  computeJobs          ComputeJob[]
  fundingIntents       FundingIntent[]
  fundingWebhookEvents FundingWebhookEvent[]
  paymentLinks         PaymentLink[]
  paywalls             Paywall[]
  products             Product[]
  sessions             Session[]
  splitConfigs         SplitConfig[]
  storedArtifacts      StoredArtifact[]
  subscriptions        Subscription[]
  subscriptionInvoices SubscriptionInvoice[]
  ownedTeam            TeamMember[]          @relation("team_merchant")
  teamMemberships      TeamMember[]          @relation("team_member")
  webhookEvents        WebhookEvent[]
  ownedWorkspaces      Workspace[]           @relation("workspace_owner")
  workspaceProfile     Workspace?            @relation("workspace_profile")

  @@map("user")
}

model Workspace {
  id        String   @id @default(cuid())
  ownerId   String
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("workspace_owner", fields: [ownerId], references: [id])
  user      User     @relation("workspace_profile", fields: [userId], references: [id], onDelete: Cascade)

  @@map("workspace")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Product {
  id                   String            @id @default(cuid())
  merchantId           String
  name                 String
  description          String?
  price                Decimal           @db.Decimal(18, 6)
  image                String?
  sku                  String?
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  billingInterval      String?
  billingIntervalCount Int               @default(1)
  billingType          String            @default("one_time")
  status               String            @default("active")
  tags                 String[]          @default([])
  images               String[]          @default([])
  // Catalog indexing: source = "console" (created in Coal's merchant console)
  // or "external" (pushed from merchant's own data via /api/agent/publish-catalog).
  // externalId is the merchant's own product ID used for idempotent upserts from
  // external sources; unique per merchant to prevent cross-merchant collisions.
  source               String            @default("console")
  externalId           String?
  billingMandates      BillingMandate[]
  checkoutSessions     CheckoutSession[]
  paymentLinks         PaymentLink[]
  merchant             User              @relation(fields: [merchantId], references: [id])
  subscriptions        Subscription[]

  @@unique([merchantId, externalId])
  @@index([merchantId, source])
  @@map("product")
}

model ApiKey {
  id         String    @id @default(cuid())
  merchantId String
  keyPrefix  String
  secretHash String
  name       String?
  lastUsed   DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  merchant   User      @relation(fields: [merchantId], references: [id])

  @@index([secretHash])
  @@map("api_key")
}

model PaymentLink {
  id              String    @id @default(cuid())
  merchantId      String
  productId       String?
  slug            String    @unique
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  description     String?
  title           String?
  payerInfoConfig Json?
  expiresAt       DateTime?
  maxUses         Int?
  useCount        Int       @default(0)
  viewCount       Int       @default(0)
  redirectUrl     String?
  allowQuantity   Boolean   @default(false)
  minQuantity     Int       @default(1)
  maxQuantity     Int       @default(1)
  merchant        User      @relation(fields: [merchantId], references: [id])
  product         Product?  @relation(fields: [productId], references: [id])

  @@map("payment_link")
}

model CheckoutSession {
  id                  String               @id @default(cuid())
  merchantId          String
  productId           String?
  amount              Decimal              @db.Decimal(18, 6)
  currency            String               @default("MNEE")
  description         String?
  splits              Json?
  status              String               @default("pending")
  txHash              String?
  redirectUrl         String?
  callbackUrl         String?
  expiresAt           DateTime
  createdAt           DateTime             @default(now())
  pendingTxHash       String?              @unique
  metadata            Json?
  authExpiresAt       DateTime?
  authId              String?
  capturedAt          DateTime?
  paymentMode         String               @default("direct")
  refundedAt          DateTime?
  voidedAt            DateTime?
  billingReason       String               @default("one_time")
  customerAddress     String?
  customerEmail       String?
  subscriptionId      String?
  payerInfo           Json?
  payerInfoConfig     Json?
  // World-3: chain the payment settles on. "base" (default) or "worldchain".
  // Drives which publicClient, USDC address, and explorer URL the verification
  // cron uses, and which CoalReceiptAnchor contract receives the optional
  // settlement-chain anchor.
  settlementChain     String               @default("base")
  fundingIntents      FundingIntent[]
  merchant            User                 @relation(fields: [merchantId], references: [id])
  product             Product?             @relation(fields: [productId], references: [id])
  refunds             Refund[]
  subscription        Subscription?        @relation(fields: [subscriptionId], references: [id])
  subscriptionInvoice SubscriptionInvoice? @relation("invoice_session")
  transactions        Transaction[]

  @@map("checkout_session")
}

model FundingIntent {
  id                   String               @id @default(cuid())
  checkoutSessionId    String
  merchantId           String
  provider             String               @default("moonpay")
  status               String               @default("pending")
  walletAddress        String
  walletType           String               @default("external")
  baseCurrencyCode     String               @default("usd")
  baseCurrencyAmount   Decimal?             @db.Decimal(18, 6)
  currencyCode         String
  quoteCurrencyAmount  Decimal              @db.Decimal(18, 6)
  fundingAsset         String               @default("eth_base")
  targetSettlementAsset String?
  gasReserve           Decimal?             @db.Decimal(18, 6)
  routeEstimate        Json?
  providerEnvironment  String?
  customerEmail        String?
  externalCustomerId   String?
  externalTransactionId String?             @unique
  providerTransactionId String?             @unique
  trackerUrl           String?
  returnUrl            String?
  resumeState          String               @default("funding_pending")
  completedAt          DateTime?
  failedAt             DateTime?
  failureReason        String?
  lastProviderStatus   String?
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  checkoutSession      CheckoutSession      @relation(fields: [checkoutSessionId], references: [id])
  merchant             User                 @relation(fields: [merchantId], references: [id])
  webhookEvents        FundingWebhookEvent[]

  @@index([checkoutSessionId, provider, walletAddress])
  @@index([merchantId, provider, status])
  @@map("funding_intent")
}

model FundingWebhookEvent {
  id                String         @id @default(cuid())
  fundingIntentId   String?
  merchantId        String?
  provider          String
  eventType         String
  dedupeKey         String         @unique
  externalEventId   String?
  externalTxId      String?
  signatureVerified Boolean        @default(false)
  payload           Json
  createdAt         DateTime       @default(now())
  fundingIntent     FundingIntent? @relation(fields: [fundingIntentId], references: [id])
  merchant          User?          @relation(fields: [merchantId], references: [id])

  @@index([provider, createdAt])
  @@map("funding_webhook_event")
}

model Transaction {
  id          String           @id @default(cuid())
  checkoutId  String?
  txHash      String           @unique
  from        String
  to          String
  amount      Decimal          @db.Decimal(18, 6)
  token       String           @default("MNEE")
  status      String
  blockNumber Int?
  // World-3: which EVM chain the transaction was mined on (8453, 84532, 480, 4801).
  // Null for legacy rows written before multi-chain support was added.
  chainId     Int?
  createdAt   DateTime         @default(now())
  checkout    CheckoutSession? @relation(fields: [checkoutId], references: [id])

  @@map("transaction")
}

model TeamMember {
  id         String   @id @default(cuid())
  merchantId String
  userId     String
  role       String   @default("member")
  invitedBy  String?
  createdAt  DateTime @default(now())
  merchant   User     @relation("team_merchant", fields: [merchantId], references: [id])
  user       User     @relation("team_member", fields: [userId], references: [id])

  @@unique([merchantId, userId])
  @@map("team_member")
}

model Paywall {
  id              String          @id @default(cuid())
  merchantId      String
  name            String
  description     String?
  price           Decimal         @db.Decimal(18, 6)
  currency        String          @default("USDC")
  contentType     String          @default("api")
  contentUrl      String?
  contentData     Json?
  pricingModel    String          @default("one_time")
  active          Boolean         @default(true)
  accessDuration  Int?
  callQuota       Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  merchant        User            @relation(fields: [merchantId], references: [id])
  accesses        PaywallAccess[]

  @@map("paywall")
}

model PaywallAccess {
  id            String    @id @default(cuid())
  paywallId     String
  address       String
  txHash        String
  accessCount   Int       @default(1)
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  lastAccessAt  DateTime?
  createdAt     DateTime  @default(now())
  paywall       Paywall   @relation(fields: [paywallId], references: [id])

  @@unique([paywallId, address])
  @@map("paywall_access")
}

model SplitConfig {
  id         String   @id @default(cuid())
  merchantId String
  name       String
  recipients Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   User     @relation(fields: [merchantId], references: [id])

  @@map("split_config")
}

model BillingMandate {
  id              String         @id @default(cuid())
  merchantId      String
  productId       String
  customerAddress String
  customerEmail   String?
  status          String         @default("active")
  acceptedAt      DateTime       @default(now())
  revokedAt       DateTime?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  merchant        User           @relation(fields: [merchantId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  subscriptions   Subscription[]

  @@unique([merchantId, productId, customerAddress])
  @@index([merchantId, status])
  @@map("billing_mandate")
}

model Subscription {
  id                 String                @id @default(cuid())
  merchantId         String
  productId          String
  mandateId          String
  latestInvoiceId    String?
  customerAddress    String
  customerEmail      String?
  status             String                @default("active")
  amount             Decimal               @db.Decimal(18, 6)
  currency           String                @default("MNEE")
  interval           String
  intervalCount      Int                   @default(1)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingAt      DateTime
  renewalCount       Int                   @default(1)
  lastPaidAt         DateTime?
  pausedAt           DateTime?
  canceledAt         DateTime?
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  checkoutSessions   CheckoutSession[]
  latestInvoice      SubscriptionInvoice?  @relation("latest_subscription_invoice", fields: [latestInvoiceId], references: [id])
  mandate            BillingMandate        @relation(fields: [mandateId], references: [id])
  merchant           User                  @relation(fields: [merchantId], references: [id])
  product            Product               @relation(fields: [productId], references: [id])
  invoices           SubscriptionInvoice[] @relation("subscription_invoices")

  @@index([merchantId, status, nextBillingAt])
  @@index([productId, customerAddress])
  @@map("subscription")
}

model SubscriptionInvoice {
  id                     String           @id @default(cuid())
  subscriptionId         String
  merchantId             String
  sequenceNumber         Int
  amount                 Decimal          @db.Decimal(18, 6)
  currency               String           @default("MNEE")
  status                 String           @default("scheduled")
  billingReason          String           @default("renewal")
  periodStart            DateTime
  periodEnd              DateTime
  dueAt                  DateTime
  hostedUrl              String?
  checkoutSessionId      String?          @unique
  paidAt                 DateTime?
  lastNotifiedAt         DateTime?
  metadata               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  latestForSubscriptions Subscription[]   @relation("latest_subscription_invoice")
  checkoutSession        CheckoutSession? @relation("invoice_session", fields: [checkoutSessionId], references: [id])
  merchant               User             @relation(fields: [merchantId], references: [id])
  subscription           Subscription     @relation("subscription_invoices", fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, sequenceNumber])
  @@index([merchantId, status, dueAt])
  @@map("subscription_invoice")
}

model Nonce {
  address   String   @id
  nonce     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("nonce")
}

model WebhookEvent {
  id             String    @id @default(cuid())
  merchantId     String
  eventType      String
  payload        Json
  url            String
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  merchant       User      @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status, nextRetryAt])
  @@map("webhook_event")
}

model StoredArtifact {
  id              String   @id @default(cuid())
  merchantId      String?
  kind            String
  layer           String   @default("log")
  localEntityType String
  localEntityId   String
  payloadHash     String
  storageRoot     String?
  storageTxHash   String?
  storageUri      String?
  streamId        String?
  kvKey           String?
  status          String   @default("published")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  merchant        User?    @relation(fields: [merchantId], references: [id])

  @@index([kind, localEntityType, localEntityId])
  @@map("stored_artifact")
}

model ChainAnchor {
  id              String   @id @default(cuid())
  merchantId      String?
  kind            String
  localEntityType String
  localEntityId   String
  payloadHash     String
  anchorContract  String
  anchorTxHash    String
  anchorChainId   Int
  status          String   @default("confirmed")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  merchant        User?    @relation(fields: [merchantId], references: [id])

  @@index([kind, localEntityType, localEntityId])
  @@map("chain_anchor")
}

model Refund {
  id          String          @id @default(cuid())
  checkoutId  String
  merchantId  String
  amount      Decimal         @db.Decimal(18, 6)
  reason      String?
  status      String          @default("pending")
  txHash      String?         @unique
  initiatedBy String
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  checkout    CheckoutSession @relation(fields: [checkoutId], references: [id])

  @@index([checkoutId])
  @@index([merchantId])
  @@map("refund")
}

model ComputeJob {
  id                 String    @id @default(cuid())
  merchantId         String?
  kind               String
  provider           String
  model              String
  inputArtifactId    String?
  outputArtifactId   String?
  status             String    @default("pending")
  verificationStatus String?
  errorMessage       String?
  metadata           Json?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  merchant           User?     @relation(fields: [merchantId], references: [id])

  @@index([kind, merchantId])
  @@map("compute_job")
}
