# Vercel production / main branch example
# Frontend points at the production backend and uses Base mainnet.

NEXT_PUBLIC_APP_URL=https://www.usecoal.xyz
NEXT_PUBLIC_API_URL=https://api.usecoal.xyz
# Leave NEXT_PUBLIC_CHAIN_ENV empty for Base mainnet
NEXT_PUBLIC_CHAIN_ENV=

NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
NEXT_PUBLIC_COINBASE_BUNDLER_KEY=your_coinbase_cdp_api_key

UPLOADTHING_SECRET=your_uploadthing_secret
UPLOADTHING_APP_ID=coal
UPLOADTHING_TOKEN=your_uploadthing_token

NEXT_PUBLIC_MOONPAY_API_KEY=your_moonpay_publishable_key
NEXT_PUBLIC_MOONPAY_ENV=production

NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_TOKEN_DECIMALS=6
NEXT_PUBLIC_SETTLEMENT_TOKEN_SYMBOL=
NEXT_PUBLIC_SETTLEMENT_TOKEN_NAME=
