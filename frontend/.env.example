NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# UploadThing
UPLOADTHING_SECRET=your_upload_thing_key
UPLOADTHING_APP_ID=coal
UPLOADTHING_TOKEN=your_upload_thing_token

# Fiat Onramp (MoonPay)
# Used only to expose the card button and client mode. The backend signs the actual MoonPay URL.
NEXT_PUBLIC_MOONPAY_API_KEY=your_moonpay_publishable_key
NEXT_PUBLIC_MOONPAY_ENV=sandbox
NEXT_PUBLIC_CARD_PAYMENTS_STATUS=coming_soon

# Chain config
NEXT_PUBLIC_CHAIN_ENV=testnet

# Settlement token on Base (ERC-20). If unset, Coal defaults to USDC.
# Preferred generic names:
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_TOKEN_DECIMALS=6
NEXT_PUBLIC_SETTLEMENT_TOKEN_SYMBOL=
NEXT_PUBLIC_SETTLEMENT_TOKEN_NAME=
#
# Legacy aliases still supported for backwards compatibility:
NEXT_PUBLIC_MNEE_BASE_ADDRESS=
NEXT_PUBLIC_MNEE_BASE_DECIMALS=6

# Privy (auth + embedded wallets)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Coinbase Developer Platform — used for Base Smart Wallet bundler
# Get your API key at https://portal.cdp.coinbase.com/
NEXT_PUBLIC_COINBASE_BUNDLER_KEY=your_coinbase_cdp_api_key
