# Your Coal API key — get one at https://usecoal.xyz/console
COAL_API_KEY=coal_live_your_key_here

# The Coal API checkouts endpoint
COAL_API_URL=https://api.usecoal.xyz/api/checkouts

# This app's public URL (used for redirects and webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ─── Agent discovery / catalog indexing ────────────────────────────────
# The merchant ID whose catalog gets indexed to 0G when this page loads.
# Defaults to the Saint merchant used across Coal's demos.
NEXT_PUBLIC_COAL_MERCHANT_ID=lst00PqEWRwcM4roiOcSpD8WfxlBc2hH

# The Coal public API base URL — used by the well-known handlers to
# fetch the merchant profile. Defaults to https://api.usecoal.xyz.
NEXT_PUBLIC_COAL_API_URL=https://api.usecoal.xyz

# Demo-grade shared secret that guards /api/coal/publish-catalog. BOTH
# vars must be set to the same value for the proxy to accept requests;
# otherwise it returns 501. In production replace this with real
# session auth, CSRF tokens, or server-side triggers.
COAL_PUBLISH_PROXY_SECRET=change-me-to-a-random-value
NEXT_PUBLIC_COAL_PUBLISH_PROXY_SECRET=change-me-to-a-random-value
