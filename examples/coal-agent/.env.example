# Required: Your OpenAI API key
OPENAI_API_KEY=sk-...

# Required: Your Coal API key (get one at https://usecoal.xyz/console/keys)
COAL_API_KEY=coal_live_...

# Optional: Coal API base URL (defaults to production)
COAL_API_URL=https://api.usecoal.xyz

# Optional: OpenAI model (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Privy — per-user agent wallets (same app as main Coal frontend)
NEXT_PUBLIC_PRIVY_APP_ID=...
PRIVY_APP_ID=...
PRIVY_APP_SECRET=...

# Optional: Base RPC URL (defaults to https://mainnet.base.org)
BASE_RPC_URL=
