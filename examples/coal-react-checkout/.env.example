# Your Coal API key — get one at https://usecoal.xyz/console
COAL_API_KEY=coal_live_your_key_here

# The Coal API base URL (backend)
COAL_API_URL=https://api.usecoal.xyz

# The Coal frontend base URL (used by the widget iframe)
NEXT_PUBLIC_COAL_BASE_URL=https://www.usecoal.xyz

# ─── Bring-Your-Own-Catalog demo (optional) ──────────────────────────────
# The merchant ID whose catalog gets indexed by the /bring-your-own-catalog
# page. Defaults to the Saint merchant used across Coal's demos.
NEXT_PUBLIC_COAL_MERCHANT_ID=lst00PqEWRwcM4roiOcSpD8WfxlBc2hH

# Demo-grade shared secret that guards /api/coal/publish-catalog. Set the
# same value in BOTH vars below to enable the demo. If unset, the proxy
# route returns 501 so drive-by attackers cannot spam your catalog.
# In production, replace this shared-secret pattern with real session auth,
# CSRF tokens, or (best) a server-side publish trigger from your DB / CMS.
COAL_PUBLISH_PROXY_SECRET=change-me-to-a-random-value
NEXT_PUBLIC_COAL_PUBLISH_PROXY_SECRET=change-me-to-a-random-value
